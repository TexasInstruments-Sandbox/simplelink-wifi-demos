<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex M.CC35X1"
            />
        </when>
    </applicability>

    <project
        title="AWS IOT Client"
        name="aws_iot_project_LP_EM_CC35X1_freertos_ticlang_10_10_00_18_projectspec"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="Cortex M.CC35X1E"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="false"
        products="com.ti.SIMPLELINK_WIFI_TOOLBOX;sysconfig:1.26.1"
        compilerBuildOptions="
            -Ofast
            -DCC35XX
            -DRAM_CONTAINER
            -DSNTP_SUPPORT
            -DNVOCMP_POSIX_MUTEX
			-DMBEDTLS_CONFIG_FILE=&apos;&quot;config-hsm.h&quot;&apos;
			-DMBEDTLS_PSA_CRYPTO_CONFIG_FILE=&apos;&quot;config-psa-crypto-hsm.h&quot;&apos;
			-DHTTP_DO_NOT_USE_CUSTOM_CONFIG
            -I${SIMPLELINK_SDK}/source
            -I${SIMPLELINK_SDK}/kernel/freertos
            -I${SIMPLELINK_SDK}/source/ti/posix/ticlang
            -I${SIMPLELINK_SDK}/source/third_party/freertos/include
            -I${SIMPLELINK_SDK}/source/third_party/freertos/portable/GCC/ARM_CM33_NTZ/non_secure
            -I${SIMPLELINK_SDK}/source/ti/net/ble_interface/inc_adapt
            -I${SIMPLELINK_SDK}/source/ti/net/ble_interface/inc_common
            -I${SIMPLELINK_SDK}/source/ti/drivers/net/wifi/wifi_platform/cc35xx/inc_common
            -I${SIMPLELINK_SDK}/source/ti/net/wifi_stack/inc_common
            -I${SIMPLELINK_SDK}/source/ti/drivers/net/wifi/wifi_host_driver/inc_common
            -I${SIMPLELINK_SDK}/source/ti/drivers/net/wifi/wifi_host_driver/inc_adapt
			-I${SIMPLELINK_SDK}/source/ti/utils/FWU
			-I${SIMPLELINK_SDK}/source/ti/utils/FWU/headers
			-I${SIMPLELINK_SDK}/source/ti/utils/FWU/headers/fwu/1.0/psa
            -I${SIMPLELINK_SDK}/tools/TI_Containers
            -I${SIMPLELINK_SDK}/source/third_party/lwip/lwip-stack/src/include
            -I${SIMPLELINK_SDK}/source/third_party/lwip/ti_config/lwip-port/osi/include
            -I${SIMPLELINK_SDK}/source/third_party/lwip/lwip-contrib
            -I${SIMPLELINK_SDK}/source/third_party/nimble/ti_config/nimble-port/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/ti_config/nimble-port/porting/npl/osi/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/nimble-src/nimble/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/nimble-src/nimble/host/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/nimble-src/nimble/host/services/gap/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/nimble-src/nimble/host/services/gatt/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/nimble-src/nimble/host/services/dis/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/nimble-src/nimble/host/util/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/nimble-src/nimble/transport/include
            -I${SIMPLELINK_SDK}/source/third_party/nimble/nimble-src/porting/nimble/include
            -I${SIMPLELINK_SDK}/source/third_party/mbedTLS
            -I${SIMPLELINK_SDK}/source/third_party/mbedTLS/include
			-I${SIMPLELINK_SDK}/source/third_party/mbedTLS/tests/include
            -I${SIMPLELINK_SDK}/source/third_party/mbedTLS/ti/configs
            -I${SIMPLELINK_SDK}/source/third_party/mbedTLS/ti/port
			-I${SIMPLELINK_SDK}/source/third_party/mbedTLS/include/psa
			-I${SIMPLELINK_SDK}/source/third_party/mbedTLS/configs
			-I${SIMPLELINK_SDK}/source/third_party/mbedTLS/include/mbedtls
			-I${SIMPLELINK_SDK}/source/third_party/mbedTLS/library
            -I${TI_MODIFIED_HEADERS}
            -I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos/ns/inc
            -I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos
            -I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos/ns/lwip/common/inc
            -I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos/platform/inc
            -I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos/transport
			-I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos/transport/aws
            -I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos/logging
			-I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos/cloud/aws
            -I${COREMQTT}/source/include
			-I${COREMQTT}/source/interface
			-I${COREHTTP}/source/include
			-I${COREHTTP}/source/dependency/3rdparty/llhttp/include
			-I${COREJSON}/source/include
			-I${BACKOFFALGORITHM}/source/include
            -I${SIMPLELINK_SDK_DEMO_ROOT}/src/freertos/transport/configs
            -I../../configs
            -I${PROJECT_ROOT}/adaptation
            -I${PROJECT_ROOT}/configs
            -I${PROJECT_ROOT}/connection
            -I${PROJECT_ROOT}/logging
            -I${PROJECT_ROOT}/utilities
            -I${PROJECT_ROOT}
            -gdwarf-3
            -mcpu=cortex-m33
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -Wall
        "
        linkerBuildOptions="
            -L${SIMPLELINK_SDK}/source
            -Wl,-l${SIMPLELINK_SDK}/source/third_party/lwip/lib/ticlang/lwip.a
            -Wl,-l${SIMPLELINK_SDK}/source/third_party/hostap/lib/ticlang/hostap.a
            -Wl,-l${SIMPLELINK_SDK}/source/third_party/nimble/lib/ticlang/nimble.a
            -Wl,-l${SIMPLELINK_SDK}/source/ti/net/wifi_stack/lib/ticlang/wifi_stack.a
            -Wl,-l${SIMPLELINK_SDK}/source/ti/net/ble_interface/lib/ticlang/ble_interface.a
            -Wl,-l${SIMPLELINK_SDK}/source/ti/drivers/net/wifi/wifi_host_driver/lib/ticlang/wifi_host_driver.a
            -Wl,-l${SIMPLELINK_SDK}/source/ti/drivers/net/wifi/wifi_platform/cc35xx/lib/ticlang/wifi_platform_cc35xx.a
            -Wl,-l${SIMPLELINK_SDK}/source/ti/utils/FWU/lib/ticlang/FWU.a
            -Wl,--reread_libs
            -L${PROJECT_BUILD_DIR}/syscfg
            -lti_utils_build_linker.cmd.genlibs
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --product ${SIMPLELINK_SDK}/.metadata/product.json
            --product ${COM_TI_SIMPLELINK_WIFI_TOOLBOX_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        description="connect to AWS IoT MQTT broker">

