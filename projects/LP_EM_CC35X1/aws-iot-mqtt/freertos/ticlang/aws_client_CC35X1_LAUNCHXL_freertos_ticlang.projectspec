        <pathVariable name="SIMPLELINK_SDK_DEMO_ROOT" path="../../../../.." scope="project"/>
        <pathVariable name="SIMPLELINK_SDK" path="../../../../../resources/simplelink-wifi-sdk" scope="project"/>
        <pathVariable name="TI_MODIFIED_HEADERS" path="../../ti_modified_headers" scope="project"/>
