            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/examples/rtos/LP_EM_CC35X1/demos/azure_iot_project_projectspec/components/azure-iot-middleware-freertos/source/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/examples/rtos/LP_EM_CC35X1/demos/azure_iot_project_projectspec/components/azure-iot-middleware-freertos/source
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/examples/rtos/LP_EM_CC35X1/demos/azure_iot_project_projectspec/components/coreMQTT/source/interface
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/examples/rtos/LP_EM_CC35X1/demos/azure_iot_project_projectspec/components/coreMQTT/source/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/examples/rtos/LP_EM_CC35X1/demos/azure_iot_project_projectspec/components/azure-iot-middleware-freertos/source/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/examples/rtos/LP_EM_CC35X1/demos/azure_iot_project_projectspec/components/coreMQTT/source/include
