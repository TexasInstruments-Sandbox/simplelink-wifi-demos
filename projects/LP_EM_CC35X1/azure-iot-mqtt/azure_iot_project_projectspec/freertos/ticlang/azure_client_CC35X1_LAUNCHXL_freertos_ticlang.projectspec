<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex M.CC35X1"
            />
        </when>
    </applicability>

    <project
        title="Azure IOT Client"
        name="azure_iot_project_LP_EM_CC35X1_freertos_ticlang_9_22_00_12_projectspec"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="Cortex M.CC35X1E"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="false"
        products="com.ti.SIMPLELINK_WIFI_SDK;com.ti.SIMPLELINK_WIFI_TOOLBOX;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -Ofast
            -DCC35XX
            -DRAM_CONTAINER
            -DSNTP_SUPPORT
            -DNVOCMP_POSIX_MUTEX
			-DMBEDTLS_CONFIG_FILE=&apos;&quot;config-hsm.h&quot;&apos;
			-DMBEDTLS_PSA_CRYPTO_CONFIG_FILE=&apos;&quot;config-psa-crypto-hsm.h&quot;&apos;
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/kernel/freertos
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/posix/ticlang
