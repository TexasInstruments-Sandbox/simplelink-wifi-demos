        <pathVariable name="COREMQTT" path="../../../../../resources/third-party/coreMQTT" scope="project"/>
        <pathVariable name="AZURE_SDK_FOR_C" path="../../../../../resources/third-party/azure-sdk-for-c" scope="project"/>

